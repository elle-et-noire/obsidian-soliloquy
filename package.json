{
	"name": "obsidian-soliloquy",
	"version": "0.1.0",
	"description": "A timeline-style journal stored in Obsidian daily notes.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"benchmark": "node scripts/benchmark.mjs",
		"benchmark:generate": "node scripts/generate-performance-vault.mjs",
		"validate:version": "node scripts/validate-version.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/commands": "6.8.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^26.1.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@lezer/markdown": "1.7.2",
		"@replit/codemirror-vim": "^6.4.0"
	}
}
